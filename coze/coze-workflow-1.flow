                    "content": "balance",
                    "rawMeta": {
                      "type": 1
                    }
                  }
                }
              },
              {
                "name": "prompt",
                "input": {
                  "type": "string",
                  "value": {
                    "type": "literal",
                    "content": "岗位信息：\n\n{{job_context}}\n\n岗位名称：\n\n{{JobName}}\n\n岗位标签：\n\n{{job_tags}}",
                    "rawMeta": {
                      "type": 1
                    }
                  }
                }
              },
              {
                "name": "enableChatHistory",
                "input": {
                  "type": "boolean",
                  "value": {
                    "type": "literal",
                    "content": false,
                    "rawMeta": {
                      "type": 3
                    }
                  }
                }
              },
              {
                "name": "chatHistoryRound",
                "input": {
                  "type": "integer",
                  "value": {
                    "type": "literal",
                    "content": "3",
                    "rawMeta": {
                      "type": 2
                    }
                  }
                }
              },
              {
                "name": "systemPrompt",
                "input": {
                  "type": "string",
                  "value": {
                    "type": "literal",
                    "content": "你是一名岗位需求分析助手。\n\n请分析岗位信息，提取真正影响候选人匹配度的核心要求，并生成简历知识库检索条件。\n\n## 规则\n\n1. 区分：\n- `required_skills`：真正影响岗位胜任的核心能力；\n- `preferred_skills`：优先、加分、特定平台或业务经验；\n- 忽略“责任心强、沟通能力好”等宽泛要求。\n\n2. 必须理解岗位中的逻辑关系：\n- 出现“或、或者、满足其一、A/B均可”等表达时，属于替代路径，候选人满足其中一条即可；\n- 不得把不同备选路径中的所有技能同时列为必备技能；\n- 出现“优先、加分、更佳”等表达时，原则上属于加分项。\n\n3. 不要机械拆关键词，应提取底层核心能力。\n\n例如：\n“订单拉取、数据统计、Excel报表自动生成”\n优先概括为“Python数据处理与业务自动化能力”，而不是拆成多个独立硬性要求。\n\n4. 区分技术能力与业务场景。\n例如“FastAPI/API开发”属于技术能力；“电商、抖店”属于具体业务或平台经验。除非岗位明确要求，否则不要把特定平台经验当作核心硬门槛。\n\n5. 从岗位中选出最重要的3-5项 `top_requirements`。\n\n`logic`：\n- `must`：核心要求；\n- `one_of`：多个路径满足其一即可；\n- `preferred`：加分要求。\n\n如果 `logic=\"one_of\"`，必须在 `alternatives` 中列出可接受路径；其他情况输出空数组。\n\n6. `query` 应同时包含核心技术、同类能力和工作场景关键词，以便检索到业务名称不同但技术相关的经历，不要只复制岗位原文。\n\n7. 不评价候选人，不生成招呼语，不根据候选人信息反向修改岗位要求。\n\n8. 必须只输出合法JSON，不要Markdown或额外说明。\n\n输出格式：\n\n{\n  \"job_category\": \"岗位类别\",\n  \"required_skills\": [\"核心能力1\", \"核心能力2\"],\n  \"preferred_skills\": [\"加分技能1\", \"加分技能2\"],\n  \"top_requirements\": [\n    {\n      \"requirement\": \"核心要求\",\n      \"importance\": 1到10的整数,\n      \"logic\": \"must | one_of | preferred\",\n      \"alternatives\": []\n    }\n  ],\n  \"query\": \"简历知识库检索文本\"\n}\n\n岗位信息：\n{{job_context}}\n\n岗位名称：\n{{JobName}}\n\n岗位标签：\n{{job_tags}}",
                    "rawMeta": {
                      "type": 1
                    }
                  }
                }
              }
            ],
            "settingOnError": {
              "processType": 1,
              "timeoutMs": 180000,
              "retryTimes": 0
            }
          },
          "outputs": [
