APP_NAME=BOSS Job Evaluator
HOST=127.0.0.1
PORT=8000
MATCH_THRESHOLD=70
DATA_DIR=data
# 默认使用 data/jobs.db；迁移到 PostgreSQL 时可直接替换连接 URL。
# DATABASE_URL=sqlite:///data/jobs.db
# 海投白名单配置；缺失、损坏、关闭或未命中时均不会保存岗位。
JOB_WHITELIST_CONFIG=config/job_whitelist.json
COZE_BASE_URL=http://127.0.0.1:8888
COZE_WORKFLOW_ID=
# 自我介绍生成 Workflow，与岗位匹配 Workflow 分开配置。
COZE_INTRODUCTION_WORKFLOW_ID=
COZE_TOKEN=
# Coze 工作流请求的最长等待时间。
COZE_TIMEOUT_SECONDS=90
# 未配置时沿用 COZE_TIMEOUT_SECONDS。
COZE_INTRODUCTION_TIMEOUT_SECONDS=90
# Coze 超时后返回给插件的降级分数。
COZE_TIMEOUT_FALLBACK_SCORE=50
